  "resources": {
    "gpus": 1,
    "cpus": 2,
    "ram_gb": 6,
    "disk_gb": 1,
    "gpu_mem_gb": 1
  },
  "limits": {
    "max_hours": 1,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/012-frozen-cuda",
    "expect": [
      {
        "path": "challenge-scores/execution-status.json",
        "contains": "\"finished\": true"
      }
    ]
  },
  "idempotent": true,
  "depends_on": [

{
  "name": "FinancialAD 012 matching CUDA frozen challenge with parity diagnostics",
  "work": "FinancialAD-LOB",
  "code": {
    "github": "SansaZheng/FinancialAD-LOB",
    "commit": "420329687fd442278304ad43b9bc58524365a67d"
  },
  "command": [
    "bash",
    "-lc",
    "set -euo pipefail\npython3 -m scripts.run_frozen_evaluation --root results/cq-012 --challenge results/cq-012/j-1127-d406c2/challenge/challenge.npz --output \"$CQ_OUTPUT_DIR/challenge-scores\" --protocol configs/012-preregistered.json --device cuda"
  ],
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8"

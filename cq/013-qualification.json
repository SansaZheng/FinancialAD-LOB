{
  "name": "FinancialAD 013 portable14-method CUDA qualification",
  "work": "FinancialAD-LOB",
  "code": {
    "github": "SansaZheng/FinancialAD-LOB",
    "commit": "9c10cdc3e3513d24cf2a82f2b5c7b9e336870441"
  },
  "command": [
    "python3",
    "-m",
    "scripts.qualify_components"
  ],
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8"
  },
  "resources": {
    "gpus": 1,
    "gpu_mem_gb": 1,
    "cpus": 2,
    "ram_gb": 6,
    "disk_gb": 0.5
  },
  "limits": {
    "max_hours": 0.3,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/013-qualification",
    "expect": [
      {
        "path": "qualification.json",
        "contains": "\"passed\": true"
      },
      {
        "path": "progress.txt",
        "contains": "1/1 complete"
      }
    ]
  },
  "idempotent": true
}

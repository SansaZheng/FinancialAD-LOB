{
  "name": "FinancialAD 012 direct scoring hard-negative CUDA qualification",
  "work": "FinancialAD-LOB",
  "code": {
    "github": "SansaZheng/FinancialAD-LOB",
    "commit": "47583e3d576195bea3be525f2eb470d70d332b65"
  },
  "command": [
    "python3",
    "-m",
    "scripts.qualify_direct",
    "--device",
    "cuda"
  ],
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8"
  },
  "resources": {
    "gpus": 1,
    "cpus": 1,
    "ram_gb": 4,
    "disk_gb": 0.2
  },
  "limits": {
    "max_hours": 0.25,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/012-qualification",
    "expect": [
      {
        "path": "qualification.json",
        "contains": "\"passed\": true"
      },
      {
        "path": "progress.txt",
        "contains": "1/1"
      }
    ],
    "progress": {
      "path": "progress.txt",
      "stall_min": 10
    }
  },
  "idempotent": true,
  "depends_on": [
    "j-1125-f2ce0f"
  ]
}

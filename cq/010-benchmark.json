  "resources": {
    "gpus": 0,
    "cpus": 1,
    "ram_gb": 4,
    "disk_gb": 1
  },
  "limits": {
    "max_hours": 0.5,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/010-benchmark",
    "expect": [
      {
        "path": "benchmark/full-day-validation.json",

      },
      {
        "path": "benchmark/manifest.json",
        "contains": "\"status\": \"complete\""
      },
      {
        "path": "progress.txt",
        "contains": "1/1"
      }
    ],
    "progress": {
      "path": "progress.txt",
      "stall_min": 25
    }

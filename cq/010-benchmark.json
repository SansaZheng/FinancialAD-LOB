  },
  "command": [
    "bash",
    "-lc",
    "set -euo pipefail\npython3 -m scripts.prepare_full_benchmark --source results/cq-010/j-1125-5d4369/full-sessions --output \"$CQ_OUTPUT_DIR/benchmark\"\ncp \"$CQ_OUTPUT_DIR/benchmark/progress.txt\" \"$CQ_OUTPUT_DIR/progress.txt\""

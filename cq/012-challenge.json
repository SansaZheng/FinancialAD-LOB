  "resources": {
    "gpus": 0,
    "cpus": 1,
    "ram_gb": 4,
    "disk_gb": 1
  },
  "limits": {
    "max_hours": 0.5,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/012-challenge",
    "expect": [
      {
        "path": "challenge/manifest.json",
        "contains": "\"status\": \"complete\""
      },
      {
        "path": "progress.txt",
        "contains": "1/1"
      }
    ],
    "progress": {
      "path": "progress.txt",
      "stall_min": 40
    }
  },
  "idempotent": true,
  "depends_on": [
    "j-1127-1d410b"
  ]

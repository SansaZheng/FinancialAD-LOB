{
  "name": "FinancialAD 012 preregistered per-level lifetime-matched benign test challenge",
  "work": "FinancialAD-LOB",
  "code": {
    "github": "SansaZheng/FinancialAD-LOB",
    "commit": "55bc00d26cc4cd8c39d5e71fdcfd631332d29dcf"
  },
  "command": [
    "bash",
    "-lc",
    "set -euo pipefail\npython3 -m lobbench.lifetime_challenge --primary results/cq-012/j-1127-1d410b/benchmark --test-source results/cq-012/j-1127-d531e0/full-sessions --output \"$CQ_OUTPUT_DIR/challenge\"\ncp \"$CQ_OUTPUT_DIR/challenge/progress.txt\" \"$CQ_OUTPUT_DIR/progress.txt\""
  ],
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONDONTWRITEBYTECODE": "1"

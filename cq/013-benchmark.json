{
  "name": "FinancialAD 013 sixty stock-day independent replay and frozen component benchmark",
  "work": "FinancialAD-LOB",
  "code": {
    "github": "SansaZheng/FinancialAD-LOB",
    "commit": "dbc90e900e8c927cdaeeb1a43819c7957c317715"
  },
  "command": [
    "bash",
    "-lc",
    "set -euo pipefail\npython3 -m scripts.prepare_direct_benchmark --sources results/cq-013/j-1128-a02e9d/full-sessions results/cq-013/j-1128-a5de09/full-sessions results/cq-013/j-1128-dcd9a2/full-sessions results/cq-013/j-1128-3545ea/full-sessions --output \"$CQ_OUTPUT_DIR/benchmark\" --protocol configs/013-preregistered.json\ncp \"$CQ_OUTPUT_DIR/benchmark/progress.txt\" \"$CQ_OUTPUT_DIR/progress.txt\""
  ],
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "resources": {
    "gpus": 0,
    "cpus": 2,
    "ram_gb": 8,
    "disk_gb": 2
  },
  "limits": {
    "max_hours": 2,
    "max_attempts": 1,
    "max_usd": 0
  },
  "placement": {
    "target": "kaggle",
    "allow_rent": false
  },
  "outputs": {
    "dest": "/Users/sudingli/.local/share/cq/kaggle/results/financialad-lob/013-benchmark",
    "expect": [
      {
        "path": "benchmark/manifest.json",
        "contains": "\"status\": \"complete\""
      },
      {
        "path": "benchmark/full-day-validation.json",
        "contains": "\"passed\": true"
      },
      {
        "path": "progress.txt",
        "contains": "1/1"
      },
      {
        "path": "benchmark/canonical-features.json",
        "contains": "\"passed\": true"
      }
    ],
    "progress": {
      "path": "progress.txt",
      "stall_min": 110
    }
  },
  "idempotent": true,
  "depends_on": [
    "j-1128-a02e9d",
    "j-1128-a5de09",
    "j-1128-dcd9a2",
    "j-1128-3545ea"
  ]
}
